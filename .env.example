# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development
APP_URL=http://localhost:3000
# Public hostnames, used by infra/compose.coolify.yml (Traefik routing) on a server.
APP_DOMAIN=
API_DOMAIN=
API_URL=http://localhost:4000
# Next.js only inlines NEXT_PUBLIC_* vars into the browser bundle — the web
# app's AuditForm.tsx (Slice 1 v1) needs this one specifically, API_URL
# above is server-side only and not visible to client components.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database ---
POSTGRES_USER=sector
POSTGRES_PASSWORD=
POSTGRES_DB=sector
DATABASE_URL=postgresql://sector:CHANGE_ME@localhost:5432/sector

# --- Redis / queue ---
REDIS_URL=redis://localhost:6379

# --- Auth (HUMAN DECISION REQUIRED — see docs/architecture/architecture.md) ---
SESSION_SECRET=
JWT_SECRET=

# --- Google integrations ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLOUD_PROJECT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Meta / Instagram / Facebook ---
META_APP_ID=
META_APP_SECRET=

# --- LinkedIn (gated — Standard Tier application pending, see skills/social-content-calendar.md) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- X (pay-per-use, see skills/social-content-calendar.md) ---
X_API_KEY=
X_API_SECRET=

# --- YouTube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Crawler / headless render (external managed service by default, see ADR-0003) ---
BROWSERLESS_API_URL=
BROWSERLESS_API_TOKEN=

# --- Ad Grants verification partner ---
GOODSTACK_API_KEY=

# --- Worker ---
WORKER_CONCURRENCY=2

# --- Added in Slices 3-5 ---
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored CMS credentials (AES-256-GCM). Required.
CREDENTIAL_ENCRYPTION_KEY=
# Leave UNSET in production. "1" lets audit/connect target localhost/private IPs (local dev + tests only) — SSRF guard.
ALLOW_PRIVATE_TARGETS=
# Max audits crawling at once per API process (public + signed-in); beyond it the API answers "busy".
AUDIT_CONCURRENCY=4
# SEctOr's Google Ads manager (MCC) customer ID, shown to NGOs in the account-link instructions.
SECTOR_MCC_ID=
# LLM provider is a founder decision (architecture.md §5). Content generation returns 501 until all three are set.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For the API trusts (per-client rate limits).
# docker-compose sets this for the api service. Leave unset when the API is directly reachable.
TRUST_PROXY=
