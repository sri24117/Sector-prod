      "html": "<div class=\"min-h-screen bg-[#EFF1F3] text-[#272727]\" data-kid=\"1\" data-name=\"audit report page container\" style=\"font-family:'Atkinson Hyperlegible',system-ui,sans-serif\">\n<style>\n@import url(\"https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700&family=Atkinson+Hyperlegible:wght@400;700&display=swap\");\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css\");\n@keyframes arc { from { stroke-dashoffset: 301.6; } }\n.arc { animation: arc 520ms cubic-bezier(.16,1,.3,1) both; }\n@keyframes rise { from { opacity: 0; transform: translateY(8px); } }\n.rise { animation: rise 260ms cubic-bezier(.16,1,.3,1) both; }\n.checkrow { transition: background-color 160ms ease, box-shadow 160ms ease; }\n.checkrow:hover { background: #F7F8F9; }\n</style>\n<div class=\"mx-auto max-w-[1312px] px-6\" data-kid=\"1-1\" data-name=\"page content wrapper\">\n<header class=\"flex h-16 items-center gap-6 border-b border-[#DDE1E5]\" data-kid=\"1-1-1\" data-name=\"report header bar with brand and login\">\n<span class=\"text-[18px] font-bold tracking-[-0.01em]\" data-kid=\"1-1-1-1\" data-name=\"brand logo text\" style=\"font-family:'Bricolage Grotesque',system-ui,sans-serif\">SEctOr</span>\n<span class=\"text-[13px] text-[#696773]\" data-kid=\"1-1-1-2\" data-name=\"report type label\">Audit result</span>\n<a class=\"ml-auto text-[13px] font-bold text-[#272727] underline decoration-[#019FB7] decoration-2 underline-offset-4\" data-kid=\"1-1-1-3\" data-name=\"login link\" href=\"#\">Log in</a>\n</header>\n<section class=\"mt-6 flex items-center gap-7 rounded-[14px] bg-white px-5 py-5\" data-kid=\"1-1-2\" data-name=\"score summary card\">\n<div class=\"relative h-[112px] w-[112px] shrink-0\" data-kid=\"1-1-2-1\" data-name=\"score gauge container\">\n<svg class=\"-rotate-90\" data-kid=\"1-1-2-1-1\" data-name=\"circular score gauge svg\" height=\"112\" viewbox=\"0 0 112 112\" width=\"112\"