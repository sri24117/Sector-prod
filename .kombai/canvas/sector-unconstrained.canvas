      "html": "<div class=\"min-h-screen bg-white text-[#070707]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Epilogue',system-ui,sans-serif\">\n<style>\n@import url(\"https://fonts.googleapis.com/css2?family=Epilogue:wght@400;500;600;700&display=swap\");\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n@keyframes slidein { from { opacity: 0; transform: translateY(6px); } }\n.rise { animation: slideUp 240ms cubic-bezier(.16,1,.3,1) both; }\n@keyframes slideUp { from { opacity: 0; transform: translateY(6px); } }\n.evidence { animation: slideUp 300ms cubic-bezier(.16,1,.3,1) both; }\n</style>\n<header class=\"flex h-16 items-center gap-6 border-b border-[#EFEFF2] px-8\" data-kid=\"1-1\" data-name=\"site header bar\">\n<span class=\"text-[18px] font-bold tracking-[-0.02em]\" data-kid=\"1-1-1\" data-name=\"brand logo text\">SEctOr</span>\n<span class=\"truncate text-[13px] text-[#7A7A84]\" data-kid=\"1-1-2\" data-name=\"audit site domain label\">roshnifoundation.org</span>\n<a class=\"ml-auto text-[13px] font-medium underline decoration-[#9901FF] decoration-2 underline-offset-4\" data-kid=\"1-1-3\" data-name=\"login link\" href=\"#\">Log in</a>\n</header>\n<div class=\"px-8\" data-kid=\"1-2\" data-name=\"audit content wrapper\">\n<div class=\"mt-6 flex flex-wrap items-center gap-4\" data-kid=\"1-2-1\" data-name=\"audit result header row\">\n<h1 class=\"text-[15px] font-semibold\" data-kid=\"1-2-1-1\" data-name=\"audit result title\">Audit result</h1>\n<a class=\"inline-flex h-8 items-center rounded-full px-3 text-[13px] font-semibold tabular-nums\" data-kid=\"1-2-1-2\" data-name=\"score badge\" href=\"#\" style=\"box-shadow:inset 0 0 0 1px #E4E4EA\">55/100</a>\n<button class=\"inline-flex h-8 items-center gap-1.5 rounded-full px-3 text-[13px] font-medium text-[#5A5A62]\" data-kid=\"1-2-1-3\" data-name=\"all checks button\" style=\"box-shadow:inset 0 0 0 1px #E4E4EA\">\n<i aria-hidden=\"true\" class=\"ti ti-list-check text-[15px]\" data-kid=\"1-2-1-3-1\" data-name=\"checklist icon\"></i>\n      All checks\n    </button>\n<span class=\"ml-auto text-[13px] text-[#7A7A84]\" data-kid=\"1-2-1-4\" data-name=\"finding counter label\">Finding 1 of 3</span>\n</div>\n<div class=\"mt-8 grid grid-cols-[minmax(0,680px)_minmax(0,488px)] gap-8 pb-14\" data-kid=\"1-2-2\" data-name=\"audit result two-column grid\">\n<section class=\"rise\" data-kid=\"1-2-2-1\" data-name=\"finding detail section\">\n<span class=\"inline-flex items-center gap-2 rounded-full px-3 py-1 text-[12px] font-bold\" data-kid=\"1-2-2-1-1\" data-name=\"attention status badge\" style=\"background:#B444FF;color:#070707\">\n<i aria-hidden=\"true\" class=\"ti ti-alert-circle text-[15px]\" data-kid=\"1-2-2-1-1-1\" data-name=\"warning icon\"></i>\n        Needs attention\n      </span>\n<h2 class=\"mt-4 max-w-[24ch] text-[30px] font-semibold leading-[1.15] tracking-[-0.02em]\" data-kid=\"1-2-2-1-2\" data-name=\"finding headline\">Search engines can tell who you are</h2>\n<p class=\"mt-4 flex flex-wrap items-baseline gap-4 text-[13px]\" data-kid=\"1-2-2-1-3\" data-name=\"score summary line\">\n<span class=\"font-semibold tabular-nums\" data-kid=\"1-2-2-1-3-1\" data-name=\"points earned value\">0 of 20 points</span>\n<span class=\"text-[#7A7A84]\" data-kid=\"1-2-2-1-3-2\" data-name=\"affected paths label\">/programmes and / (homepage)</span>\n</p>\n<p class=\"mt-6 max-w-[62ch] text-[16px] leading-[1.7]\" data-kid=\"1-2-2-1-4\" data-name=\"finding description text\">Your site doesn't describe your organization in the standard format that search engines and AI assistants read directly.</p>\n<div class=\"mt-6 max-w-[62ch]\" data-kid=\"1-2-2-1-5\" data-name=\"why-it-matters explanation block\">\n<p class=\"text-[12px] font-semibold text-[#7A7A84]\" data-kid=\"1-2-2-1-5-1\" data-name=\"why it matters label\">Why it matters</p>\n<p class=\"mt-1.5 text-[16px] leading-[1.7] text-[#5A5A62]\" data-kid=\"1-2-2-1-5-2\" data-name=\"why it matters description text\">Without it they have to guess your name, purpose and website from the page text, and may get it wrong or leave you out.</p>\n</div>\n<div class=\"mt-8 flex flex-wrap gap-3\" data-kid=\"1-2-2-1-6\" data-name=\"meta facts row container\">\n<span class=\"inline-flex flex-col gap-1 rounded-[20px] bg-[#F6F5FA] px-4 py-3\" data-kid=\"1-2-2-1-6-1\" data-name=\"effort stat card\">\n<span class=\"text-[11px] text-[#7A7A84]\" data-kid=\"1-2-2-1-6-1-1\" data-name=\"effort stat label\">Effort</span>\n<span class=\"text-[14px] font-semibold\" data-kid=\"1-2-2-1-6-1-2\" data-name=\"effort stat value\">About 10 minutes</span>\n</span>\n<span class=\"inline-flex flex-col gap-1 rounded-[20px] bg-[#F6F5FA] px-4 py-3\" data-kid=\"1-2-2-1-6-2\" data-name=\"method stat card\">\n<span class=\"text-[11px] text-[#7A7A84]\" data-kid=\"1-2-2-1-6-2-1\" data-name=\"method stat label\">Method</span>\n<span class=\"text-[14px] font-semibold\" data-kid=\"1-2-2-1-6-2-2\" data-name=\"method stat value\">WordPress fix</span>\n</span>\n<span class=\"inline-flex flex-col gap-1 rounded-[20px] bg-[#F6F5FA] px-4 py-3\" data-kid=\"1-2-2-1-6-3\" data-name=\"followup stat card\">\n<span class=\"text-[11px] text-[#7A7A84]\" data-kid=\"1-2-2-1-6-3-1\" data-name=\"afterwards stat label\">Afterwards</span>\n<span class=\"text-[14px] font-semibold\" data-kid=\"1-2-2-1-6-3-2\" data-name=\"afterwards stat value\">Re-crawled and re-scored</span>\n</span>\n</div>\n<div class=\"mt-9 flex flex-wrap items-center gap-4 border-t border-[#EFEFF2] pt-6\" data-kid=\"1-2-2-1-7\" data-name=\"action buttons row\">\n<a class=\"inline-flex h-11 items-center gap-2 rounded-full px-5 text-[14px] font-semibold text-white\" data-kid=\"1-2-2-1-7-1\" data-name=\"review proposed change primary button\" href=\"#\" style=\"background:#9901FF\">\n          Review proposed change\n          <i aria-hidden=\"true\" class=\"ti ti-eye text-[16px]\" data-kid=\"1-2-2-1-7-1-1\" data-name=\"eye icon\"></i>\n</a>\n<a class=\"inline-flex h-11 items-center rounded-full px-4 text-[14px] font-medium text-[#5A5A62]\" data-kid=\"1-2-2-1-7-2\" data-name=\"view fix steps secondary button\" href=\"#\" style=\"box-shadow:inset 0 0 0 1px #E4E4EA\">View fix steps</a>\n</div>\n</section>\n<aside class=\"evidence self-start rounded-[20px] p-6\" data-kid=\"1-2-2-2\" data-name=\"evidence panel\" style=\"background:#222630;color:#FFFFFF\">\n<p class=\"text-[12px] font-semibold\" data-kid=\"1-2-2-2-1\" data-name=\"evidence panel title\" style=\"color:rgba(255,255,255,0.55)\">Evidence</p>\n<dl class=\"mt-4\" data-kid=\"1-2-2-2-2\" data-name=\"evidence details list\">\n<div class=\"flex items-baseline justify-between gap-4 pb-3\" data-kid=\"1-2-2-2-2-1\" data-name=\"check row\">\n<dt class=\"text-[12px]\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"check term label\" style=\"color:rgba(255,255,255,0.6)\">Check</dt>\n<dd class=\"font-mono text-[12px]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"check value\">schema</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-t border-white/10 py-3\" data-kid=\"1-2-2-2-2-2\" data-name=\"result row\">\n<dt class=\"text-[12px] text-white/60\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"result term label\">Result</dt>\n<dd class=\"text-[13px] font-semibold\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"result value\">No structured data found</dd>\n</div>\n<div class=\"flex items-start justify-between gap-4 border-t border-white/10 py-3\" data-kid=\"1-2-2-2-2-3\" data-name=\"detail row\">\n<dt class=\"shrink-0 text-[12px] text-white/60\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"detail term label\">Detail</dt>\n<dd class=\"text-right text-[13px] leading-relaxed break-words\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"detail value\">no ld+json blocks on / (homepage)</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-t border-white/10 py-3\" data-kid=\"1-2-2-2-2-4\" data-name=\"crawled row\">\n<dt class=\"text-[12px] text-white/60\" data-kid=\"1-2-2-2-2-4-1\" data-name=\"crawled term label\">Crawled</dt>\n<dd class=\"text-[13px] tabular-nums\" data-kid=\"1-2-2-2-2-4-2\" data-name=\"crawled date value\">27 Oct 2026, 10:41</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-t border-white/10 py-3\" data-kid=\"1-2-2-2-2-5\" data-name=\"crawler scope row\">\n<dt class=\"text-[12px] text-white/60\" data-kid=\"1-2-2-2-2-5-1\" data-name=\"crawler scope term label\">Crawler scope</dt>\n<dd class=\"text-[13px]\" data-kid=\"1-2-2-2-2-5-2\" data-name=\"crawler scope value\">Homepage</dd>\n</div>\n</dl>\n<div class=\"mt-5 rounded-[16px] p-4\" data-kid=\"1-2-2-2-3\" data-name=\"proposed code block panel\" style=\"background:#2B303C\">\n<p class=\"text-[12px] text-[#A9ACB6]\" data-kid=\"1-2-2-2-3-1\" data-name=\"proposed block label\">Proposed block</p>\n<pre class=\"mt-2 overflow-hidden whitespace-pre-wrap break-words text-[12px] leading-[1.7] text-[#E7E8EC]\" data-kid=\"1-2-2-2-3-2\" data-name=\"proposed JSON code sample\">{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"NGO\",\n  \"name\": \"Roshni Foundation\",\n  \"url\": \"https://roshnifoundation.org\"\n}</pre>\n<p class=\"mt-3 text-[11px] text-[#8A8E99]\" data-kid=\"1-2-2-2-3-3\" data-name=\"approval note text\">Not applied. Added to the homepage head on your approval.</p>\n</div>\n</aside></div>\n</div>\n</div>",
