      "html": "<div class=\"min-h-screen bg-[#2E2E2E] text-[#D4D4D4]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Asap',system-ui,sans-serif\">\n<style>\n@import url(\"https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600&family=Asap:wght@400;500&display=swap\");\n@import url(\"https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css\");\n@keyframes jobin { from { opacity: 0; transform: translateY(5px); } }\n.job { animation: slideUp 220ms cubic-bezier(.16,1,.3,1) both; }\n@keyframes slideUp { from { opacity: 0; transform: translateY(6px); } }\n.docket { transition: background-color 140ms ease; }\n.docket:hover { background:#373737; }\n</style>\n<header class=\"flex h-16 items-center gap-6 border-b border-white/10 px-5\" data-kid=\"1-1\" data-name=\"header bar\">\n<span class=\"text-[18px] font-semibold tracking-[-0.01em]\" data-kid=\"1-1-1\" data-name=\"brand name logo\" style=\"font-family:'Prompt',system-ui,sans-serif\">SEctOr</span>\n<span class=\"truncate text-[13px] text-white/55\" data-kid=\"1-1-2\" data-name=\"site domain label\">roshnifoundation.org</span>\n<a class=\"ml-auto text-[13px] font-medium underline decoration-[#922020] decoration-2 underline-offset-4\" data-kid=\"1-1-3\" data-name=\"login link\" href=\"#\">Log in</a>\n</header>\n<div class=\"px-5\" data-kid=\"1-2\" data-name=\"main content wrapper\">\n<div class=\"flex flex-wrap items-end justify-between gap-6 border-b border-white/10 py-4\" data-kid=\"1-2-1\" data-name=\"score summary header row\">\n<div class=\"flex items-end gap-2\" data-kid=\"1-2-1-1\" data-name=\"score value group\">\n<span class=\"text-[52px] font-semibold leading-none tabular-nums\" data-kid=\"1-2-1-1-1\" data-name=\"score number\" style=\"font-family:'Prompt',system-ui,sans-serif\">55</span>\n<span class=\"pb-1.5 text-[14px] text-white/55\" data-kid=\"1-2-1-1-2\" data-name=\"score total denominator\">/100</span>\n</div>\n<div class=\"flex flex-wrap items-center gap-7 pb-1\" data-kid=\"1-2-1-2\" data-name=\"score breakdown group\">\n<span class=\"text-[13px]\" data-kid=\"1-2-1-2-1\" data-name=\"failing count label\"><span class=\"font-semibold text-white\" data-kid=\"1-2-1-2-1-1\" data-name=\"failing count number\">3</span> failing</span>\n<span class=\"text-[13px]\" data-kid=\"1-2-1-2-2\" data-name=\"passing count label\"><span class=\"font-semibold text-white\" data-kid=\"1-2-1-2-2-1\" data-name=\"passing count number\">4</span> passing</span>\n<a class=\"inline-flex items-center gap-1.5 text-[13px] underline decoration-white/30 underline-offset-4\" data-kid=\"1-2-1-2-3\" data-name=\"all checks link\" href=\"#\">\n        All seven checks\n        <i aria-hidden=\"true\" class=\"bx bx-right-arrow-alt text-[16px]\" data-kid=\"1-2-1-2-3-1\" data-name=\"right arrow icon\"></i>\n</a>\n</div>\n</div>\n<div class=\"flex items-center justify-between border-b border-white/10 py-2.5\" data-kid=\"1-2-2\" data-name=\"section header row\">\n<p class=\"text-[13px] font-medium\" data-kid=\"1-2-2-1\" data-name=\"section title text\">Needs attention</p>\n<div class=\"flex items-center gap-5 text-[13px]\" data-kid=\"1-2-2-2\" data-name=\"sort controls group\">\n<span class=\"text-white/50\" data-kid=\"1-2-2-2-1\" data-name=\"sort by label\">Sort by</span>\n<button class=\"font-semibold text-white underline decoration-[#922020] decoration-2 underline-offset-4\" data-kid=\"1-2-2-2-2\" data-name=\"sort by effort active button\">Effort</button>\n<button class=\"text-white/55\" data-kid=\"1-2-2-2-3\" data-name=\"sort by points button\">Points</button>\n</div>\n</div>\n<div class=\"grid grid-cols-[minmax(0,820px)_minmax(0,1fr)] gap-5 py-5 pb-12\" data-kid=\"1-2-3\" data-name=\"two column grid layout\">\n<section aria-label=\"Failed checks\" class=\"job\" data-kid=\"1-2-3-1\" data-name=\"failed checks list section\">\n<button class=\"docket flex w-full items-center gap-4 px-4 py-4 text-left\" data-kid=\"1-2-3-1-1\" data-name=\"failed check card item\" style=\"background:#414141;clip-path:polygon(10px 0, 100% 0, 100% 100%, 0 100%, 0 10px)\">\n<span class=\"h-10 w-[3px] shrink-0\" data-kid=\"1-2-3-1-1-1\" data-name=\"red priority accent bar\" style=\"background:#922020\"></span>\n<span class=\"min-w-0 flex-1\" data-kid=\"1-2-3-1-1-2\" data-name=\"check card detail container\">\n<span class=\"block text-[16px] font-medium leading-snug\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"check card title\" style=\"font-family:'Prompt',system-ui,sans-serif\">Search engines can tell who you are</span>\n<span class=\"mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[12px] text-white/60\" data-kid=\"1-2-3-1-1-2-2\" data-name=\"check card meta row\">\n<span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-1-2-2-1\" data-name=\"method label with icon\"><i aria-hidden=\"true\" class=\"bx bx-plug text-[14px]\" data-kid=\"1-2-3-1-1-2-2-1-1\" data-name=\"plug icon\"></i>WordPress fix</span>\n<span data-kid=\"1-2-3-1-1-2-2-2\" data-name=\"estimated time label\">About 10 minutes</span>\n</span>\n</span>\n<span class=\"shrink-0 text-right\" data-kid=\"1-2-3-1-1-3\" data-name=\"points group\">\n<span class=\"block text-[18px] font-semibold tabular-nums\" data-kid=\"1-2-3-1-1-3-1\" data-name=\"points number\" style=\"font-family:'Prompt',system-ui,sans-serif\">20</span>\n<span class=\"block text-[11px] text-white/50\" data-kid=\"1-2-3-1-1-3-2\" data-name=\"points label\">points</span>\n</span>\n</button>\n<button class=\"docket mt-1 flex w-full items-center gap-4 px-4 py-4 text-left\" data-kid=\"1-2-3-1-2\" data-name=\"check card item\" style=\"clip-path:polygon(10px 0, 100% 0, 100% 100%, 0 100%, 0 10px);border-bottom:1px solid rgba(212,212,212,0.16)\">\n<span class=\"min-w-0 flex-1\" data-kid=\"1-2-3-1-2-1\" data-name=\"check card detail container\">\n<span class=\"block text-[16px] font-medium leading-snug\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"check card title\" style=\"font-family:'Prompt',system-ui,sans-serif\">A summary file for AI tools</span>\n<span class=\"mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[12px] text-white/60\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"check card meta row\">\n<span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"method label with icon\"><i aria-hidden=\"true\" class=\"bx bx-wrench text-[14px]\" data-kid=\"1-2-3-1-2-1-2-1-1\" data-name=\"wrench icon\"></i>Manual steps</span>\n<span data-kid=\"1-2-3-1-2-1-2-2\" data-name=\"estimated time label\">About 15 minutes, low priority</span>\n</span>\n</span>\n<span class=\"shrink-0 text-right\" data-kid=\"1-2-3-1-2-2\" data-name=\"points group\">\n<span class=\"block text-[18px] font-semibold tabular-nums\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"points number\" style=\"font-family:'Prompt',system-ui,sans-serif\">5</span>\n<span class=\"block text-[11px] text-white/50\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"points label\">points</span>\n</span>\n</button>\n<button class=\"docket flex w-full items-center gap-4 px-4 py-4 text-left\" data-kid=\"1-2-3-1-3\" data-name=\"check card item\" style=\"clip-path:polygon(10px 0, 100% 0, 100% 100%, 0 100%, 0 10px);border-bottom:1px solid rgba(212,212,212,0.16)\">\n<span class=\"min-w-0 flex-1\" data-kid=\"1-2-3-1-3-1\" data-name=\"check card detail container\">\n<span class=\"block text-[16px] font-medium leading-snug\" data-kid=\"1-2-3-1-3-1-1\" data-name=\"check card title\" style=\"font-family:'Prompt',system-ui,sans-serif\">Common questions, answered</span>\n<span class=\"mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[12px] text-white/60\" data-kid=\"1-2-3-1-3-1-2\" data-name=\"check card meta row\">\n<span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-3-1-3-1-2-1\" data-name=\"method label with icon\"><i aria-hidden=\"true\" class=\"bx bx-wrench text-[14px]\" data-kid=\"1-2-3-1-3-1-2-1-1\" data-name=\"wrench icon\"></i>Manual steps</span>\n<span data-kid=\"1-2-3-1-3-1-2-2\" data-name=\"estimated time label\">About 30 to 60 minutes of writing</span>\n</span>\n</span>\n<span class=\"shrink-0 text-right\" data-kid=\"1-2-3-1-3-2\" data-name=\"points group\">\n<span class=\"block text-[18px] font-semibold tabular-nums\" data-kid=\"1-2-3-1-3-2-1\" data-name=\"points number\" style=\"font-family:'Prompt',system-ui,sans-serif\">20</span>\n<span class=\"block text-[11px] text-white/50\" data-kid=\"1-2-3-1-3-2-2\" data-name=\"points label\">points</span>\n</span>\n</button>\n</section>\n<section class=\"job self-start p-5\" data-kid=\"1-2-3-2\" data-name=\"check detail panel\" style=\"background:#414141;box-shadow:0 8px 18px -10px rgba(0,0,0,0.6)\">\n<div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-3-2-1\" data-name=\"detail header row\">\n<h2 class=\"max-w-[26ch] text-[20px] font-medium leading-tight\" data-kid=\"1-2-3-2-1-1\" data-name=\"detail panel title\" style=\"font-family:'Prompt',system-ui,sans-serif\">Search engines can tell who you are</h2>\n<span class=\"shrink-0 text-[12px] text-white/60\" data-kid=\"1-2-3-2-1-2\" data-name=\"progress score text\">0/20</span>\n</div>\n<p class=\"mt-4 text-[16px] leading-[1.65]\" data-kid=\"1-2-3-2-2\" data-name=\"primary problem description text\">Your site doesn't describe your organization in the standard format that search engines and AI assistants read directly.</p>\n<p class=\"mt-3 text-[16px] leading-[1.65] text-white/65\" data-kid=\"1-2-3-2-3\" data-name=\"secondary impact description text\">Without it they have to guess your name, purpose and website from the page text, and may get it wrong or leave you out.</p>\n<dl class=\"mt-5 border-t border-white/15 pt-3 text-[13px]\" data-kid=\"1-2-3-2-4\" data-name=\"detail metadata list\">\n<div class=\"flex items-baseline justify-between gap-4 py-1.5\" data-kid=\"1-2-3-2-4-1\" data-name=\"metadata row\">\n<dt class=\"text-white/55\" data-kid=\"1-2-3-2-4-1-1\" data-name=\"metadata label\">Effort</dt>\n<dd data-kid=\"1-2-3-2-4-1-2\" data-name=\"metadata value\">About 10 minutes, or we do it for you</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-t border-white/10 py-1.5\" data-kid=\"1-2-3-2-4-2\" data-name=\"metadata row\">\n<dt class=\"text-white/55\" data-kid=\"1-2-3-2-4-2-1\" data-name=\"metadata label\">Where</dt>\n<dd class=\"text-right\" data-kid=\"1-2-3-2-4-2-2\" data-name=\"metadata value\">/ (homepage)</dd>\n</div>\n<div class=\"flex items-baseline justify-between gap-4 border-t border-white/10 py-1.5\" data-kid=\"1-2-3-2-4-3\" data-name=\"metadata row\">\n<dt class=\"text-white/55\" data-kid=\"1-2-3-2-4-3-1\" data-name=\"metadata label\">Method</dt>\n<dd data-kid=\"1-2-3-2-4-3-2\" data-name=\"metadata value\">WordPress fix</dd>\n</div>\n</dl>\n<div class=\"mt-5 flex flex-wrap items-center gap-4\" data-kid=\"1-2-3-2-5\" data-name=\"action buttons row\">\n<a class=\"inline-flex h-10 items-center gap-2 px-4 text-[14px] font-medium\" data-kid=\"1-2-3-2-5-1\" data-name=\"primary action button with arrow\" href=\"#\" style=\"background:#922020;color:#F2EDED;clip-path:polygon(8px 0, 100% 0, 100% 100%, 0 100%, 0 8px)\">\n          Review proposed change\n          <i aria-hidden=\"true\" class=\"bx bx-right-arrow-alt text-[16px]\" data-kid=\"1-2-3-2-5-1-1\" data-name=\"right arrow icon\"></i>\n</a>\n<a class=\"text-[13px] text-white/65 underline decoration-white/25 underline-offset-4\" data-kid=\"1-2-3-2-5-2\" data-name=\"secondary action link\" href=\"#\">View fix steps</a>\n</div>\n<p class=\"mt-4 text-[12px] leading-relaxed text-white/45\" data-kid=\"1-2-3-2-6\" data-name=\"technical detail note\">Technical detail: no ld+json blocks on / (homepage)</p>\n</section>\n</div>\n</div>\n</div>",
